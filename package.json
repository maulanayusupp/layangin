{
  "name": "layangin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Layangin \u2014 an Indonesian kite-fighting game built with Nuxt.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "^22.12.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:styles": "node scripts/check-inline-styles.mjs",
    "lint:i18n": "node scripts/check-i18n.mjs",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "replay": "vitest run --config vitest.tools.config.ts",
    "verify": "pnpm lint && pnpm lint:styles && pnpm lint:i18n && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@nuxtjs/i18n": "10.6.0",
    "@pinia/nuxt": "1.0.2",
    "@vueuse/nuxt": "14.4.0",
    "nuxt": "4.4.8",
    "pinia": "4.0.3",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/test-utils": "4.1.0",
    "eslint": "10.8.1",
    "png-to-ico": "3.0.2",
    "sass-embedded": "1.102.0",
    "sharp": "0.35.3",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.9",
    "vitest": "4.1.10"
  }
}
